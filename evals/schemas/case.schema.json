{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QE Agent Skill Evaluation Case File",
  "description": "Structural schema for one skill's six-case evaluation dataset. Cross-file and repository-dependent invariants are documented separately and require custom validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "source",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "description"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.claude/skills/[a-z][a-z0-9-]*/SKILL\\.md$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/case"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "type": {
                "const": "positive"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 3,
          "maxContains": 3
        },
        {
          "contains": {
            "properties": {
              "type": {
                "const": "negative"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 2,
          "maxContains": 2
        },
        {
          "contains": {
            "properties": {
              "type": {
                "const": "behavioral"
              }
            },
            "required": [
              "type"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "prompt",
        "expected_routing",
        "expectations",
        "fixture"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*-[1-9][0-9]*$"
        },
        "type": {
          "enum": [
            "positive",
            "negative",
            "behavioral"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected_routing": {
          "enum": [
            "activate",
            "do_not_activate"
          ]
        },
        "expectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fixture": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "routing_expectation": {
          "$ref": "#/$defs/routingExpectation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "positive"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "expected_routing": {
                "const": "activate"
              }
            },
            "not": {
              "required": [
                "routing_expectation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "behavioral"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "expected_routing": {
                "const": "activate"
              },
              "expectations": {
                "minItems": 5,
                "maxItems": 5
              }
            },
            "not": {
              "required": [
                "routing_expectation"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "negative"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "expected_routing": {
                "const": "do_not_activate"
              }
            },
            "required": [
              "routing_expectation"
            ]
          }
        }
      ]
    },
    "routingExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_primary_skill",
        "allowed_companion_skills",
        "forbidden_skills",
        "direct_response_allowed",
        "rationale",
        "expected_action"
      ],
      "properties": {
        "expected_primary_skill": {
          "oneOf": [
            {
              "$ref": "#/$defs/skillId"
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_companion_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillId"
          }
        },
        "forbidden_skills": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/skillId"
          }
        },
        "direct_response_allowed": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "expected_action": {
          "enum": [
            "activate_skill",
            "direct_response",
            "local_change"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_action": {
                "const": "activate_skill"
              }
            },
            "required": [
              "expected_action"
            ]
          },
          "then": {
            "properties": {
              "expected_primary_skill": {
                "$ref": "#/$defs/skillId"
              },
              "direct_response_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_action": {
                "const": "direct_response"
              }
            },
            "required": [
              "expected_action"
            ]
          },
          "then": {
            "properties": {
              "expected_primary_skill": {
                "type": "null"
              },
              "direct_response_allowed": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "expected_action": {
                "const": "local_change"
              }
            },
            "required": [
              "expected_action"
            ]
          },
          "then": {
            "properties": {
              "expected_primary_skill": {
                "type": "null"
              },
              "direct_response_allowed": {
                "const": false
              }
            }
          }
        }
      ]
    }
  }
}
